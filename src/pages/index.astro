---
import BaseLayout from "../layouts/BaseLayout.astro";

const experience = [
	{
		role: ".NET Developer",
		company: "Intersoft",
		period: "Jan 2026 — Present",
		location: "Egham, England · Hybrid",
		points: [
			"Azure-based microservices and monolithic projects on .NET 8 and .NET Framework 4.8.",
			"Working across SQL and Docker-based environments.",
		],
	},
	{
		role: "Full Stack Web Developer (Angular, .NET & SQL)",
		company: "Atomus",
		period: "Dec 2022 — Jan 2026 · 3 yrs 2 mos",
		location: "Farnham, England · Hybrid",
		points: [
			"Built and maintained full-stack features with Angular, .NET 6/8, and SQL.",
			"Set up and maintained Azure CI/CD pipelines across RDBMS-backed services.",
		],
	},
	{
		role: "VBA & Web Developer",
		company: "Audit Intelligence",
		period: "Feb 2022 — Nov 2022 · 10 mos",
		location: "",
		points: [
			"Delivered internal tooling spanning project management and software development.",
		],
	},
];

const projectCategories = [
	{
		name: "Full-Stack",
		projects: [
			{
				name: "Athena Toolkit",
				featured: true,
				description: "My most extensive personal project — a self-hosted microservices platform with an Angular frontend and .NET backend, SQL-backed services, and each service deployed as its own Docker image via GitHub Actions to a home Unraid server.",
				tags: ["Angular", ".NET", "SQL", "Self-Hosted", "Docker", "CI/CD"],
				link: "https://github.com/lee-stevens/athena-toolkit",
			},
			{
				name: "local-repo-monitor",
				description: "A lightweight web app for keeping an eye on local git repositories — status, branches, staged/unstaged changes — run as a background Docker container.",
				tags: ["Docker", "Tooling"],
				link: "https://github.com/lee-stevens/local-repo-monitor",
			},
		],
	},
	{
		name: "Game Development",
		projects: [
			{
				name: "Project Arkane",
				description: "A single-player survival RTS colony builder in Unity — resource economy, base fortification, and automated defence against escalating enemy waves.",
				tags: ["Unity", "C#", "Game Dev"],
				link: "https://github.com/lee-stevens/project-arkane",
			},
			{
				name: "Project Tau",
				description: "A Unity 6 tower defence / survival game project, designed and built from a full game design document.",
				tags: ["Unity", "C#", "Game Dev"],
				link: "https://github.com/lee-stevens/Project-Tau",
			},
		],
	},
];
---

<BaseLayout title="Lee Stevens — .NET Developer">
	<section id="hero">
		<div style="display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
			<img
				src="/images/avatar.jpg"
				width="120"
				height="120"
				alt="Lee Stevens"
				style="width: 120px; height: 120px; flex-shrink: 0; border-radius: 50%; object-fit: cover; border: 1px solid var(--border);"
			/>
			<div style="flex: 1 1 320px; min-width: 0;">
				<h1>Lee Stevens</h1>
				<p style="font-size: 1.25rem; color: var(--text-muted); margin: 0;">
					.NET Developer based in London, working across C#, Angular, SQL, and Azure — with a side
					of Unity game development.
				</p>
			</div>
		</div>
		<p>
			I build full-stack and backend systems professionally, and spend my spare time on game
			and tooling projects — from a Unity colony-sim to self-hosted dev tools.
		</p>
		<p>
			<a href="#projects">View projects</a> &nbsp;·&nbsp; <a href="#contact">Get in touch</a>
		</p>
	</section>

	<section id="experience">
		<h2>Experience</h2>
		{experience.map((job) => (
			<div style="margin-bottom: 2rem;">
				<h3 style="margin-bottom: 0.1em;">{job.role}</h3>
				<p style="color: var(--text-muted); margin: 0 0 0.75em;">
					{job.company} &nbsp;·&nbsp; {job.period}
					{job.location && <>&nbsp;·&nbsp; {job.location}</>}
				</p>
				<ul style="margin: 0; padding-left: 1.25em;">
					{job.points.map((point) => (
						<li>{point}</li>
					))}
				</ul>
			</div>
		))}
	</section>

	<section id="projects">
		<h2>Projects</h2>
		{projectCategories.map((category, i) => (
			<div style={`margin-bottom: ${i === projectCategories.length - 1 ? "0" : "2.5rem"};`}>
				<h3 style="color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.85rem; margin-bottom: 1rem;">
					{category.name}
				</h3>

				{category.projects.filter((p) => p.featured).map((project) => (
					<a
						href={project.link}
						target="_blank"
						rel="noopener noreferrer"
						style="display: block; border: 1px solid var(--accent); background: var(--bg-elevated); border-radius: 10px; padding: 1.5rem; text-decoration: none; color: var(--text); margin-bottom: 1.25rem;"
					>
						<p style="color: var(--accent); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5em;">
							Featured project
						</p>
						<h4 style="margin-bottom: 0.4em; color: var(--text); font-size: 1.15rem;">{project.name}</h4>
						<p style="color: var(--text-muted); margin-bottom: 0.75em;">{project.description}</p>
						<div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
							{project.tags.map((tag) => (
								<span style="font-size: 0.75rem; color: var(--accent); border: 1px solid var(--border); border-radius: 999px; padding: 0.15em 0.6em;">
									{tag}
								</span>
							))}
						</div>
					</a>
				))}

				<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.25rem;">
					{category.projects.filter((p) => !p.featured).map((project) => (
						<a
							href={project.link}
							target="_blank"
							rel="noopener noreferrer"
							style="display: block; border: 1px solid var(--border); background: var(--bg-elevated); border-radius: 10px; padding: 1.25rem; text-decoration: none; color: var(--text);"
						>
							<h4 style="margin-bottom: 0.4em; color: var(--text); font-size: 1.05rem;">{project.name}</h4>
							<p style="color: var(--text-muted); margin-bottom: 0.75em;">{project.description}</p>
							<div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
								{project.tags.map((tag) => (
									<span style="font-size: 0.75rem; color: var(--accent); border: 1px solid var(--border); border-radius: 999px; padding: 0.15em 0.6em;">
										{tag}
									</span>
								))}
							</div>
						</a>
					))}
				</div>
			</div>
		))}
	</section>

	<section id="contact">
		<h2>Contact</h2>
		<p>
			Email: <a href="mailto:lee.stevens.core@gmail.com">lee.stevens.core@gmail.com</a>
		</p>
		<p>
			GitHub: <a href="https://github.com/lee-stevens" target="_blank" rel="noopener noreferrer">github.com/lee-stevens</a>
		</p>
	</section>
</BaseLayout>
